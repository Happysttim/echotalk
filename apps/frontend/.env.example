VITE_API_BASE_URL=/api
# Only read by the Vite development server; never bundled in the browser.
API_PROXY_TARGET=http://localhost:8080
# Public OAuth client ID; the client secret belongs only on the backend.
VITE_GOOGLE_CLIENT_ID=
# Must match the backend GOOGLE_REDIRECT_URL and Google Console exactly.
VITE_GOOGLE_REDIRECT_URI=/auth/google/callback
